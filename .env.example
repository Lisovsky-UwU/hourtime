# Copy to .env and adjust. Read by docker compose and by the backend (pydantic-settings).

# --- docker compose ---
POSTGRES_USER=hourtime
POSTGRES_PASSWORD=hourtime
POSTGRES_DB=hourtime
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- backend ---
HOURTIME_DATABASE_URL=postgresql+psycopg://hourtime:hourtime@localhost:5432/hourtime
HOURTIME_REDIS_URL=redis://localhost:6379/0

# redis | memory. "memory" keeps the cache in the API process (dev/tests only).
HOURTIME_CACHE_BACKEND=redis

# How long an authenticated request may work from cached session/user rows.
# App changes invalidate on commit; this only bounds edits made straight in the DB.
HOURTIME_CACHE_TTL_SECONDS=300

# Turn off once your own account exists — the app runs on a public IP.
HOURTIME_ALLOW_REGISTRATION=true

HOURTIME_ACCESS_TOKEN_TTL_MINUTES=30
HOURTIME_REFRESH_TOKEN_TTL_DAYS=30
HOURTIME_SESSION_RETENTION_DAYS=90

HOURTIME_PASSWORD_MIN_LENGTH=10

# Comma-separated origins allowed to call the API from a browser.
HOURTIME_CORS_ORIGINS=http://localhost:5173

HOURTIME_LOG_LEVEL=INFO
HOURTIME_SQL_ECHO=false
